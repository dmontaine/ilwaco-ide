# Host-specific GTK dev symlinks generated by build-linux.sh (point at absolute
# system paths, so they must not be committed — regenerate with ./build-linux.sh shim).
/Compilers/shim/gtk-dev/

# FreeBASIC crash dump written by the runtime on an unhandled error.
DebugInfo.log

# Scratch-save the IDE writes beside the current tab's file (TabWindow.bas) when it needs a
# on-disk copy of an unsaved buffer. A runtime artifact, never source — Astoria committed
# several of these by accident (Examples/*/Temp.bas).
Temp.bas

# What the IDE had open when it was last closed (SaveWorkspace). Per-machine session state
# regenerated on every exit, not source — same call Astoria made.
Settings/Workspace.ini
