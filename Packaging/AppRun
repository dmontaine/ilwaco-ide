#!/usr/bin/env bash
#
# AppRun — the Ilwaco AppImage entry point.
#
# THE PROBLEM THIS SOLVES
# -----------------------
# Ilwaco resolves everything relative to FreeBASIC's ExePath() — Settings,
# Templates, Compilers, Resources, Temp — and it *writes* to several of them
# (Settings/ilwaco.ini and Settings/Workspace.ini on exit, Temp/Compile.log on
# every build, .bak files on save). An AppImage is a read-only squashfs, so the
# IDE cannot simply run from inside it.
#
# ExePath() resolves symlinks (measured 2026-08-07: it reads /proc/self/exe, so
# a symlink into the image reports the image's path, not the link's). That rules
# out the obvious trick of symlinking the binary into a writable directory —
# only a *real file* there gives a writable ExePath.
#
# So AppRun's whole job is to materialise a writable copy of the release tree in
# ~/Ilwaco (override with ILWACO_HOME) and hand over to ilwaco.sh, the same
# launcher an ordinary installed copy uses. Everything below is about that
# materialisation; the actual launch logic lives in ilwaco.sh.
#
#   ~/Ilwaco/
#     ilwaco, ilwaco-mcp,      real copies — ExePath() must be writable, and
#     ilwaco.sh                ilwaco.sh must sit beside them
#     Settings/ Temp/          real, writable — the IDE writes these
#     Projects/ Examples/ …    the user's work, seeded once and never touched
#     Compilers/ Help/ …       symlinks into the mounted image
#     Toolchain/               symlink to the image's bundled link toolchain
#
# The image mounts at a different path every run (/tmp/.mount_XXXXXX), so every
# symlink into it is stale by the next launch. They are therefore recreated on
# each start — cheap, and it also picks up an upgraded image.
#
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
APPDIR="${APPDIR:-$(dirname "$SELF")}"
PAYLOAD="$APPDIR/usr/share/ilwaco"
APPHOME="${ILWACO_HOME:-$HOME/Ilwaco}"

die() { echo "Ilwaco: $*" >&2; exit 1; }

[ -d "$PAYLOAD" ] || die "broken package: $PAYLOAD is missing"

mkdir -p "$APPHOME" || die "cannot create $APPHOME"
[ -w "$APPHOME" ]   || die "$APPHOME is not writable"

# --- seeded once, then owned by the user -------------------------------------
# Never refreshed: a user's settings, projects and edited examples must survive
# an upgrade.
for d in Settings Templates AddIns Projects Examples Documentation; do
	[ -e "$APPHOME/$d" ] && continue
	if [ -d "$PAYLOAD/$d" ]; then cp -a "$PAYLOAD/$d" "$APPHOME/$d"; else mkdir -p "$APPHOME/$d"; fi
done
mkdir -p "$APPHOME/Temp"

# --- bulk read-only payload: relinked every launch ---------------------------
for d in Compilers Controls Resources Help CHMVIEW Toolchain; do
	[ -e "$PAYLOAD/$d" ] || continue
	rm -rf "$APPHOME/$d"          # may be a stale symlink from a previous mount
	ln -s "$PAYLOAD/$d" "$APPHOME/$d"
done

# --- real copies -------------------------------------------------------------
# ExePath() follows symlinks and would report the read-only image, so these must
# be real files. Refreshed when the image carries a different build, so that
# upgrading the AppImage upgrades the IDE.
for f in ilwaco ilwaco-mcp ilwaco.sh license.txt; do
	src="$PAYLOAD/$f"
	[ -f "$src" ] || continue
	if [ ! -f "$APPHOME/$f" ] || [ "$src" -nt "$APPHOME/$f" ] \
	   || [ "$(stat -c %s "$src")" != "$(stat -c %s "$APPHOME/$f")" ]; then
		cp -f "$src" "$APPHOME/$f.tmp$$" && mv -f "$APPHOME/$f.tmp$$" "$APPHOME/$f"
	fi
done
chmod +x "$APPHOME/ilwaco" "$APPHOME/ilwaco.sh" 2>/dev/null || true
[ -x "$APPHOME/ilwaco.sh" ] || die "broken package: no launcher in the image"

# Everything machine-specific — the GTK link targets, the first-run settings,
# PATH and LD_LIBRARY_PATH — is ilwaco.sh's job, shared with installed copies.
exec "$APPHOME/ilwaco.sh" "$@"
